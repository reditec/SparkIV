<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SparkIV.WinUI.Viewers.HexView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="InspectorNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <TextBox x:Name="GoToBox" Width="190" Margin="0,0,8,0" PlaceholderText="Go to offset (hex)" KeyDown="GoToBox_KeyDown"
                         FontFamily="Cascadia Mono, Consolas, Courier New" ToolTipService.ToolTip="Offset in hex, e.g. 1A40 or 0x1A40; press Enter" />
            </AppBarElementContainer>
            <AppBarToggleButton x:Name="InspectorButton" Label="Inspector" Click="Inspector_Click" ToolTipService.ToolTip="Show or hide the data inspector">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9D9;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton Label="Copy as hex" Click="CopyHex_Click" ToolTipService.ToolTip="Copy the selected bytes as hex (Ctrl+C in the hex column)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Copy as text" Click="CopyText_Click" ToolTipService.ToolTip="Copy the selected bytes as text (Ctrl+C in the text column)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ExportButton" Label="Export original" Click="ExportOriginal_Click" ToolTipService.ToolTip="Save the file exactly as it is in the archive">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- Offset, hex and text columns are drawn by HexView.html, only the rows on screen -->
                    <WebView2 x:Name="Web" Margin="3" DefaultBackgroundColor="Transparent" />
                    <ProgressRing x:Name="Working" IsActive="True" Width="32" Height="32" />
                </Grid>
            </Border>

            <!-- The values the bytes at the caret stand for -->
            <Border x:Name="InspectorPane" Grid.Column="1" Width="250"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer Padding="12,8,12,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Data inspector" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="At the caret, little-endian" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                        <Grid x:Name="InspectorGrid" ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" Margin="4,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
