<UserControl
    x:Class="SparkIV.WinUI.Viewers.TextDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarElementContainer x:Name="FormatContainer" Visibility="Collapsed" VerticalContentAlignment="Center">
                <ComboBox x:Name="FormatBox" MinWidth="180" Margin="0,0,8,0" SelectionChanged="FormatBox_SelectionChanged" />
            </AppBarElementContainer>
            <AppBarToggleButton x:Name="FunctionsButton" Label="Functions" Visibility="Collapsed" Click="Functions_Click"
                                ToolTipService.ToolTip="Show or hide the list of functions">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton x:Name="FoldButton" Label="Collapse all" Visibility="Collapsed" Click="FoldAll_Click">
                <AppBarButton.Icon><FontIcon x:Name="FoldIcon" Glyph="&#xE70E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarToggleButton x:Name="WrapButton" Label="Word wrap" Click="Wrap_Click">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE751;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton Label="Copy all" Click="CopyAll_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SaveTextButton" Label="Save as text" Click="SaveText_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Export original" Click="ExportOriginal_Click" ToolTipService.ToolTip="Save the file exactly as it is in the archive">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- The text is shown by a small page (TextDocumentView.html): the browser engine keeps even
                         very long lines on one row, so the line numbers always line up. -->
                    <WebView2 x:Name="Web" Margin="3" DefaultBackgroundColor="Transparent" />
                    <ProgressRing x:Name="Working" IsActive="True" Width="32" Height="32" />
                </Grid>
            </Border>

            <!-- Functions of a script; a click jumps there -->
            <Border x:Name="FunctionPane" Grid.Column="1" Width="220" Visibility="Collapsed"
                    CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FunctionHeader" Margin="12,8,12,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Functions" />
                    <ListView x:Name="FunctionList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="FunctionList_ItemClick"
                              Padding="0,0,0,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="CaretStatus" Grid.Row="2" Margin="4,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
