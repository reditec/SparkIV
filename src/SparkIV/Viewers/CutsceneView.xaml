<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SparkIV.WinUI.Viewers.CutsceneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SparkIV.WinUI.Viewers">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarToggleButton x:Name="CameraButton" Label="Cutscene camera" IsChecked="True" Click="Camera_Click"
                                ToolTipService.ToolTip="Look through the cutscene's camera (turning the view by mouse leaves it)">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE714;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton x:Name="LightsButton" Label="Scene lights" IsChecked="True" Click="Lights_Click"
                                ToolTipService.ToolTip="Light the scene with its own lights (the spots and fill lights the cutscene sets)">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xE781;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton x:Name="SubtitlesButton" Label="Subtitles" IsChecked="True" Click="Subtitles_Click"
                                ToolTipService.ToolTip="Show the subtitles over the view">
                <AppBarToggleButton.Icon><FontIcon Glyph="&#xED1E;" /></AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ComboBox x:Name="BackgroundBox" MinWidth="120" Margin="0,0,8,0" SelectionChanged="BackgroundBox_SelectionChanged"
                          ToolTipService.ToolTip="Background of the view">
                    <x:String>Gradient</x:String>
                    <x:String>Grey</x:String>
                    <x:String>Black</x:String>
                    <x:String>White</x:String>
                </ComboBox>
            </AppBarElementContainer>
            <AppBarButton Label="Fit" Click="Fit_Click" ToolTipService.ToolTip="Look at everyone in the scene (or double-click the view)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE9A6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Export original" Click="ExportOriginal_Click" ToolTipService.ToolTip="Save the file exactly as it is in the archive">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The sections, the cast, the subtitles -->
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="4" Padding="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sections" Margin="12,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="SectionList" Grid.Row="1" SelectionMode="Single" MaxHeight="180" SelectionChanged="SectionList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CutSectionRow">
                                <StackPanel Padding="0,2">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="Cast" Margin="12,6,12,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="CastList" Grid.Row="3" SelectionMode="None" MaxHeight="220">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CutActorRow">
                                <StackPanel Padding="0,2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="4" Text="Subtitles" Margin="12,6,12,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="SubtitleList" Grid.Row="5" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SubtitleList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CutSubtitleRow">
                                <StackPanel Padding="0,2">
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- Drawn with WebGL by ModelView.html: left drag turns, middle or right drag moves, wheel zooms -->
                    <WebView2 x:Name="Web" Margin="3" DefaultBackgroundColor="Transparent" />
                    <ProgressRing x:Name="Working" IsActive="True" Width="32" Height="32" />
                    <TextBlock x:Name="Message" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- The subtitle shown now, as in the game: at the bottom, light on a dark shade -->
                    <Border x:Name="SubtitleBox" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,24"
                            Padding="12,6" CornerRadius="4" Background="#A0000000" IsHitTestVisible="False">
                        <TextBlock x:Name="SubtitleText" Foreground="White" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="760" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Playing: the time over the whole scene (the sections' starts marked), step, play -->
        <Grid Grid.Row="2" Padding="8,4" ColumnSpacing="12" CornerRadius="{ThemeResource OverlayCornerRadius}"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="3">
                <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" StepFrequency="1" ValueChanged="TimeSlider_ValueChanged"
                        IsThumbToolTipEnabled="False" AutomationProperties.Name="Time" />
                <!-- Where each section starts, over the slider's track -->
                <Canvas x:Name="SectionMarks" IsHitTestVisible="False" SizeChanged="SectionMarks_SizeChanged" />
            </Grid>

            <TextBlock x:Name="FrameText" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Click="PreviousSection_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Previous section" AutomationProperties.Name="Previous section">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button Click="Previous_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Previous frame" AutomationProperties.Name="Previous frame">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                </Button>
                <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="48" Height="36"
                        ToolTipService.ToolTip="Play / pause (space)" AutomationProperties.Name="Play">
                    <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button Click="Next_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Next frame" AutomationProperties.Name="Next frame">
                    <FontIcon Glyph="&#xE76C;" FontSize="16" />
                </Button>
                <Button Click="NextSection_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Next section" AutomationProperties.Name="Next section">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="SectionText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="3" Margin="4,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
