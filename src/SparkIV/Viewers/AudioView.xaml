<UserControl
    x:Class="SparkIV.WinUI.Viewers.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:SparkIV.WinUI.Model">

    <UserControl.Resources>
        <CollectionViewSource x:Name="TrackSource" IsSourceGrouped="True" />
    </UserControl.Resources>

    <Grid RowSpacing="6" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="ExportWaveButton" Label="Export as WAV" Click="ExportWave_Click"
                          ToolTipService.ToolTip="Convert the selected track to a WAV file">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ExportAllButton" Label="Export all channels" Click="ExportAll_Click"
                          ToolTipService.ToolTip="Convert the whole bank to one multichannel WAV file">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B1;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Export original" Click="ExportOriginal_Click"
                          ToolTipService.ToolTip="Save the file exactly as it is in the archive; only this can be edited and imported back">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- Tracks: multichannel tracks in their own group, with the mono waves they are stored as -->
        <Border Grid.Row="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,4,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ColumnHeaderStyle}" Content="Name" Tag="Name" Click="SortColumn_Click" />
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Content="Channels" Tag="Channels" Click="SortColumn_Click" />
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Content="Length" Tag="Length" Click="SortColumn_Click" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Content="Sample rate" Tag="Rate" Click="SortColumn_Click" HorizontalContentAlignment="Right" />
                </Grid>

                <ListView x:Name="TrackList" Grid.Row="1" SelectionMode="Single"
                          DoubleTapped="TrackList_DoubleTapped" KeyDown="TrackList_KeyDown" SelectionChanged="TrackList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="model:AudioTrackGroup">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:AudioTrackRow">
                            <Grid Opacity="{x:Bind RowOpacity}" ToolTipService.ToolTip="Double-click to play">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="{x:Bind NamePadding}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                    <TextBlock Text="{x:Bind Name}" FontWeight="{x:Bind NameWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Channels}" Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Padding="8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind RateText}" Padding="8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Transport -->
        <Border Grid.Row="2" Padding="12,8" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="10" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NowPlaying" Grid.ColumnSpan="8" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <Button x:Name="PlayButton" Grid.Row="1" Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="44" Height="36"
                        ToolTipService.ToolTip="Play (Space)" AutomationProperties.Name="Play">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Click="Stop_Click" Width="40" Height="36" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>

                <TextBlock x:Name="PositionText" Grid.Row="1" Grid.Column="2" Text="0:00" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"
                           FontFamily="Cascadia Mono, Consolas, Courier New" />
                <Slider x:Name="PositionSlider" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False" ValueChanged="PositionSlider_ValueChanged" AutomationProperties.Name="Position" />
                <TextBlock x:Name="LengthText" Grid.Row="1" Grid.Column="4" Text="0:00" VerticalAlignment="Center" MinWidth="40"
                           FontFamily="Cascadia Mono, Consolas, Courier New" />

                <ToggleButton x:Name="LoopButton" Grid.Row="1" Grid.Column="5" Height="36" Click="Loop_Click" ToolTipService.ToolTip="Play looped">
                    <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                </ToggleButton>
                <ToggleButton x:Name="DownmixButton" Grid.Row="1" Grid.Column="6" Height="36" Click="Downmix_Click" IsEnabled="False"
                              ToolTipService.ToolTip="Mix tracks with more than two channels (LCR, 5.0) down to stereo; off sends every channel to its own speaker">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F5;" FontSize="14" />
                        <TextBlock Text="Stereo downmix" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Grid.Row="1" Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                    <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
