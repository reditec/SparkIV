<Window
    x:Class="SparkIV.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="12,0,0,0">
            <TextBlock Text="Settings" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- One tab per area of settings; each shows the panel with its Tag as name. -->
        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="16,0,16,4" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem Text="Game folders" Tag="GameFoldersPage" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Backups" Tag="BackupsPage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Cutscenes" Tag="CutscenesPage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE714;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Updates" Tag="UpdatesPage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE895;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="About" Tag="AboutPage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE946;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <InfoBar x:Name="Info" Grid.Row="2" Margin="16,0,16,8" IsOpen="False" Severity="Error" />

        <Grid x:Name="Pages" Grid.Row="3">
            <ScrollViewer x:Name="GameFoldersPage" Padding="24,8,24,24">
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Where each game is installed, per platform. Without a folder set, SparkIV uses the one Windows knows (registry) or asks for it when it is needed. In the Complete Edition both games are the same folder." />
                    <StackPanel x:Name="GameFolderList" Spacing="4" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="BackupsPage" Padding="24,8,24,24" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Before SparkIV writes a game file the first time, it keeps the original here: files of a game by game and path in the game, others by drive and path. A file's backup is never replaced, so it stays the file as it was before the first change. To undo, copy it back." />
                    <Border Padding="16,12,16,12" CornerRadius="4" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Backup folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="BackupFolderText" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="BackupStateText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Open" Click="OpenBackupFolder_Click" />
                                <Button Content="Browse…" Click="BrowseBackupFolder_Click" />
                                <Button x:Name="ResetBackupButton" Content="Reset" Click="ResetBackupFolder_Click"
                                        ToolTipService.ToolTip="Use the default folder in Documents again" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CutscenesPage" Padding="24,8,24,24" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="How the cutscene player shows what a cutscene file asks for. Changes apply to cutscenes opened afterwards." />
                    <Border Padding="16,12,16,12" CornerRadius="4" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="See-through parts as in the game" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="The game decides once, from a person's first parts, whether it has see-through parts, and doesn't draw see-through parts a cutscene adds later (Bernie's headband in bc_1). Off: show every part the cutscene asks for." />
                            </StackPanel>
                            <ToggleSwitch x:Name="SeeThroughSwitch" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent="" MinWidth="0" Toggled="SeeThroughSwitch_Toggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdatesPage" Padding="24,8,24,24" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="At start, SparkIV checks GitHub for a newer version in the chosen channel and offers to install it. A channel doesn't go back to an older version: after switching from Alpha to Release, the next update is the first release newer than the version installed." />
                    <Border Padding="16,12,16,12" CornerRadius="4" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Update channel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ChannelBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="240"
                                      SelectionChanged="ChannelBox_SelectionChanged">
                                <ComboBoxItem Content="Alpha: alpha, beta and releases" Tag="Alpha" />
                                <ComboBoxItem Content="Beta: beta and releases" Tag="Beta" />
                                <ComboBoxItem Content="Release: releases only" Tag="Release" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Padding="24,8,24,24" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="AboutVersionText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="A file browser, viewer and editor for Grand Theft Auto IV and Episodes from Liberty City (PC)." />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Text="Copyright (C) 2026 reditec. Based on SparkIV and RageLib by aru (2008–2009), continued by Ahmed Walid (ahmed605) and Silent Spud." />
                    <TextBlock TextWrapping="Wrap"
                               Text="SparkIV is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version. It is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="License (GPLv3)" Click="ShowLicense_Click" />
                        <Button Content="Third-party notices" Click="ShowNotices_Click" />
                        <Button Content="Source code" Click="OpenSource_Click" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="SparkIV is an unofficial fan project. It is not affiliated with, endorsed or sponsored by Rockstar Games or Take-Two Interactive. Grand Theft Auto, GTA and related names are trademarks of Take-Two Interactive Software, Inc." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
