<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SparkIV.WinUI</RootNamespace>
    <AssemblyName>SparkIV</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\SparkIV.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- A plain exe: no MSIX package, and the Windows App SDK runtime ships next to it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Builds SparkIV.pri with the compiled XAML; without it dotnet publish leaves both out and the app can't start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Rendering/D3D12: buffer uploads and the SwapChainPanel's native interface. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- File and Directory are also RageLib type names. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Program.cs is the entry point, so the updater (Velopack) runs before the app starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GC compacts sooner and gives memory back: a cutscene's location (the intro's harbour: 0.9 GB kept) peaked at
         5.6 GB while loading without, 2.5 GB with (same time); 9 gained little more. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- The Direct3D 12 renderer of the cutscene, model and animation views. -->
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\SparkIV.ico" Link="SparkIV.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licenses ship with the program; Settings > About shows them. -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Settings > About shows it, and after an update the new version's part (ChangelogDialog). -->
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Viewers\TextDocumentView.html" LogicalName="SparkIV.TextDocumentView.html" />
    <EmbeddedResource Include="Viewers\HexView.html" LogicalName="SparkIV.HexView.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RageLib\RageLib.csproj" />
  </ItemGroup>

</Project>