<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SparkIV</RootNamespace>
    <AssemblyName>SparkIV</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- File and Directory are also RageLib type names; implicit usings would make them ambiguous. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties\AssemblyInfo.cs still holds the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\GTAIV.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <StartupObject>SparkIV.Program</StartupObject>
    <!-- WFO1000 (designer serialization of public control properties) only matters in the designer; this app is replaced by WinUI. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RageLib\RageLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Viewer\Xml\defaultss.xslt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SparkIV.Config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ookii.Dialogs.WinForms" Version="4.0.0" />
  </ItemGroup>

</Project>
