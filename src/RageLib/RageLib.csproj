<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RageLib</RootNamespace>
    <AssemblyName>RageLib</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- File, Directory, Path ... are also RageLib type names; implicit usings would make them ambiguous. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties\AssemblyInfo.cs still holds the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The audio, texture and model views are WinForms/WPF until the WinUI app replaces them. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- WFO1000 (designer serialization of public control properties) only matters in the designer, and these views are replaced by WinUI. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Audio\SoundBank\Hashes\Names.txt" />
    <EmbeddedResource Include="FileSystem\RPF\KnownFilenames.txt" />
    <EmbeddedResource Include="Scripting\Script\NativesList.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lib\ragezip.dll">
      <Link>ragezip.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ookii.Dialogs.WinForms" Version="4.0.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
