<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SparkIV.WinUI.Viewers.TextureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:SparkIV.WinUI.Model">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ComboBox x:Name="LevelBox" MinWidth="170" Margin="0,0,8,0" SelectionChanged="LevelBox_SelectionChanged"
                          ToolTipService.ToolTip="Mipmap level" />
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ComboBox x:Name="ChannelBox" MinWidth="110" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="ChannelBox_SelectionChanged"
                          ToolTipService.ToolTip="Show all channels, or one of them as grey">
                    <x:String>RGBA</x:String>
                    <x:String>Red</x:String>
                    <x:String>Green</x:String>
                    <x:String>Blue</x:String>
                    <x:String>Alpha</x:String>
                </ComboBox>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ComboBox x:Name="BackgroundBox" MinWidth="130" Margin="0,0,8,0" SelectionChanged="BackgroundBox_SelectionChanged"
                          ToolTipService.ToolTip="What shows through where the texture is see-through">
                    <x:String>Gradient</x:String>
                    <x:String>Checkerboard</x:String>
                    <x:String>Black</x:String>
                    <x:String>White</x:String>
                </ComboBox>
            </AppBarElementContainer>
            <AppBarButton Label="Fit" Click="Fit_Click" ToolTipService.ToolTip="Fit the texture into the window">
                <AppBarButton.Icon><FontIcon Glyph="&#xE9A6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="100 %" Click="ActualSize_Click" ToolTipService.ToolTip="Show the texture pixel for pixel">
                <AppBarButton.Icon><FontIcon Glyph="&#xE71E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Export as PNG" Click="ExportPng_Click" ToolTipService.ToolTip="Save the selected texture as a PNG image">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ExportAllButton" Label="Export all" Click="ExportAll_Click" ToolTipService.ToolTip="Save every texture as a PNG image into a folder">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Export original" Click="ExportOriginal_Click" ToolTipService.ToolTip="Save the file exactly as it is in the archive">
                <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The textures of the dictionary -->
            <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FilterBox" Margin="8,8,8,0" PlaceholderText="Filter" TextChanged="FilterBox_TextChanged" />
                    <ListView x:Name="TextureList" Grid.Row="1" SelectionMode="Single" SelectionChanged="TextureList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:TextureRow">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- The texture; Ctrl+wheel or pinch zooms. The background is chosen in the toolbar. -->
            <Border x:Name="PreviewArea" Grid.Column="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid x:Name="PreviewLayer" SizeChanged="PreviewLayer_SizeChanged">
                    <!-- The texture is placed and scaled by a transform: wheel zooms around the mouse, dragging with the
                         left or middle button (or a finger) moves it, pinching zooms. -->
                    <!-- A canvas, because a grid would cut the image to its own size before it is scaled -->
                    <Canvas x:Name="PreviewViewport" Background="Transparent" ManipulationMode="TranslateX,TranslateY,Scale"
                            SizeChanged="PreviewViewport_SizeChanged" PointerWheelChanged="PreviewViewport_PointerWheelChanged"
                            ManipulationStarted="PreviewViewport_ManipulationStarted" ManipulationDelta="PreviewViewport_ManipulationDelta"
                            ManipulationCompleted="PreviewViewport_ManipulationCompleted">
                        <Image x:Name="Preview" Stretch="None" RenderTransformOrigin="0,0">
                            <Image.RenderTransform>
                                <CompositeTransform x:Name="PreviewTransform" />
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                    <ProgressRing x:Name="Working" IsActive="False" Width="32" Height="32" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="4,0,4,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <!-- Zoom, on a logarithmic scale from 10 % to 3200 % -->
            <Slider x:Name="ZoomSlider" Grid.Column="1" Width="180" Minimum="0" Maximum="1000" StepFrequency="1" VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="Zoom" />
            <TextBlock x:Name="ZoomText" Grid.Column="2" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
