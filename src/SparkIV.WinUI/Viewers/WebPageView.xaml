<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SparkIV.WinUI.Viewers.WebPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Like a browser: back, forward, home and the address of the page -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="Back_Click" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Click="Forward_Click" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" Click="Home_Click" Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Home page (Eyefind)" AutomationProperties.Name="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="14" />
            </Button>
            <TextBox x:Name="AddressBox" Grid.Column="3" IsReadOnly="True" VerticalAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas, Courier New" />
            <CommandBar Grid.Column="4" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarElementContainer x:Name="LanguageContainer" VerticalContentAlignment="Center" Visibility="Collapsed">
                    <ComboBox x:Name="LanguageBox" MinWidth="120" Margin="8,0,8,0" SelectionChanged="LanguageBox_SelectionChanged"
                              ToolTipService.ToolTip="The language of the game texts on the pages (menus, labels); the rest of a page is the same in every language" />
                </AppBarElementContainer>
                <AppBarButton x:Name="TexturesButton" Label="Textures" Click="Textures_Click"
                              ToolTipService.ToolTip="Open the images of this page in the texture viewer">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEB9F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Export as HTML" Click="ExportHtml_Click"
                              ToolTipService.ToolTip="Save this page as HTML with its images as PNG files into a folder">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Export original" Click="ExportOriginal_Click"
                              ToolTipService.ToolTip="Save the .whm file of this page exactly as it is in the archive">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- The page and its images are served from memory under https://whm.sparkiv/ -->
                <WebView2 x:Name="Web" Margin="3" DefaultBackgroundColor="White" />
                <ProgressRing x:Name="Working" IsActive="True" Width="32" Height="32" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
